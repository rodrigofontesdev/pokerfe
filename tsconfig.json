{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@shared/*": ["./src/shared/*"],
      "@room/*": ["./src/room/*"],
      "@worker/*": ["./src/worker/*"],
      "@client/*": ["./src/client/*"]
    }
  },
  "include": ["src", "tests", "*.config.ts", "aliases.ts"]
}
